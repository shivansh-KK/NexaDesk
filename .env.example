# ShopAssist Configuration

# Database
DATABASE_URL=sqlite:///./shopassist.db

# LLM Providers (gemini | ollama | mock)
DEFAULT_PROVIDER=gemini

# Google Gemini Settings (official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Guardrails & Prompt Version
GUARDRAILS_ENABLED=true
PROMPT_VERSION=v2_guarded
MAX_TOOL_STEPS=6
PENDING_ACTION_TIMEOUT_MINUTES=10

ENVIRONMENT=development
